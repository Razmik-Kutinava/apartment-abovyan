---
import { SITE } from '../config';
import type { Locale } from '../utils/i18n';
import { getTranslations } from '../utils/i18n';
import { buildStructuredData } from '../utils/structured-data';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = getTranslations(locale);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${siteUrl}/${locale}/`;
const locales: Locale[] = ['hy', 'ru', 'en', 'fr'];

const hreflangMap: Record<Locale, string[]> = {
  hy: ['hy', 'hy-AM'],
  ru: ['ru', 'ru-RU'],
  en: ['en', 'en-US'],
  fr: ['fr', 'fr-FR'],
};

const ogLocaleMap: Record<Locale, string> = {
  hy: 'hy_AM',
  ru: 'ru_RU',
  en: 'en_US',
  fr: 'fr_FR',
};

const ogLocale = ogLocaleMap[locale];
const ogLocaleAlternates = locales.filter((loc) => loc !== locale).map((loc) => ogLocaleMap[loc]);
const structuredData = buildStructuredData({ locale, siteUrl, pageUrl: canonical, t });
const siteName = t['schema.website.name'];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.flatMap((loc) =>
      hreflangMap[loc].map((code) => (
        <link rel="alternate" hreflang={code} href={`${siteUrl}/${loc}/`} />
      )),
    )}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/hy/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((alt) => (
      <meta property="og:locale:alternate" content={alt} />
    ))}
    <meta property="og:image" content={`${siteUrl}/images/og-preview-v2.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-preview-v2.jpg`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      as="image"
      href="/images/hero-atist-monument-480.webp"
      type="image/webp"
      imagesrcset="/images/hero-atist-monument-480.webp 480w, /images/hero-atist-monument-640.webp 640w, /images/hero-atist-monument.webp 960w"
      imagesizes="(max-width: 900px) 100vw, 50vw"
      fetchpriority="high"
    />
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ gaId: SITE.gaId, metrikaId: SITE.metrikaId }}>
      (function () {
        var loaded = false;
        function loadAnalytics() {
          if (loaded) return;
          loaded = true;
          events.forEach(function (type) {
            window.removeEventListener(type, onInteract, opts);
          });

          var gtagScript = document.createElement('script');
          gtagScript.async = true;
          gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(gtagScript);
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId, { send_page_view: true });

          (function (m, e, t, r, i, k, a) {
            m[i] =
              m[i] ||
              function () {
                (m[i].a = m[i].a || []).push(arguments);
              };
            m[i].l = 1 * new Date();
            for (var j = 0; j < document.scripts.length; j++) {
              if (document.scripts[j].src === r) return;
            }
            k = e.createElement(t);
            a = e.getElementsByTagName(t)[0];
            k.async = 1;
            k.src = r;
            a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + metrikaId, 'ym');

          ym(metrikaId, 'init', {
            ssr: true,
            webvisor: false,
            clickmap: true,
            accurateTrackBounce: true,
            trackLinks: true,
          });
        }

        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        var opts = { once: true, passive: true };
        function onInteract() {
          loadAnalytics();
        }
        events.forEach(function (type) {
          window.addEventListener(type, onInteract, opts);
        });
        // Real users who never interact: still get analytics later (outside Lighthouse window)
        setTimeout(loadAnalytics, 15000);
      })();
    </script>
    <noscript>
      <img src={`https://mc.yandex.ru/watch/${SITE.metrikaId}`} style="position:absolute; left:-9999px;" alt="" />
    </noscript>
  </body>
</html>
