---
import type { Translations } from '../utils/i18n';

interface Props { t: Translations; }
const { t } = Astro.props;

const groups = [
  {
    title: t['gallery.group.entrance'],
    images: [
      { src: '/images/gallery/07-hallway.jpg', alt: t['img.gallery.07.alt'] },
      { src: '/images/gallery/10-hallway-2.jpg', alt: t['img.gallery.10.alt'] },
    ],
  },
  {
    title: t['gallery.group.living'],
    images: [
      { src: '/images/gallery/02-living.jpg', alt: t['img.gallery.02.alt'] },
      { src: '/images/gallery/08-kitchen.jpg', alt: t['img.gallery.08.alt'] },
    ],
  },
  {
    title: t['gallery.group.bedrooms'],
    images: [
      { src: '/images/gallery/05-bedroom-light.jpg', alt: t['img.gallery.05.alt'] },
      { src: '/images/gallery/04-bedroom.jpg', alt: t['img.gallery.04.alt'] },
    ],
  },
] as const;
---

<section class="section section--surface" id="gallery">
  <div class="container">
    <div class="section__header">
      <h2>{t['gallery.title']}</h2>
      <p class="section__lead">{t['gallery.subtitle']}</p>
    </div>
    <div class="gallery-groups">
      {groups.map((group) => (
        <div class="gallery-group">
          <h3 class="gallery-group__title">{group.title}</h3>
          <div class="gallery-group__photos">
            {group.images.map((img) => (
              <figure class="gallery-group__figure">
                <img src={img.src} alt={img.alt} loading="lazy" width="400" height="280" />
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .gallery-group__title {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
  }

  .gallery-group__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }

  .gallery-group__figure {
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--color-surface);
  }

  .gallery-group__figure img {
    display: block;
    width: 100%;
    height: 132px;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .gallery-groups {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .gallery-group__figure img {
      height: 148px;
    }
  }
</style>
