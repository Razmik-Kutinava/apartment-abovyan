---
import type { Translations } from '../utils/i18n';
import { buildWhatsAppUrl } from '../utils/whatsapp';

interface Props { t: Translations; }
const { t } = Astro.props;
const waUrl = buildWhatsAppUrl(t['hero.cta_prefill']);
---

<section class="hero" aria-label="Hero">
  <div class="hero__media" role="img" aria-label={t['img.hero.alt']}>
    <picture class="hero__poster">
      <source
        type="image/webp"
        srcset="/images/hero-atist-monument-480.webp 480w, /images/hero-atist-monument-640.webp 640w, /images/hero-atist-monument.webp 960w"
        sizes="(max-width: 900px) 100vw, 50vw"
      />
      <img
        src="/images/hero-atist-monument.jpg"
        alt=""
        width="960"
        height="823"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      class="hero__video"
      data-src="/video/abovyan_garni.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
  </div>
  <div class="container hero__content">
    <span class="badge">{t['hero.badge']}</span>
    <h1>{t['hero.title']}</h1>
    <p class="hero__subtitle">{t['hero.subtitle']}</p>
    <p class="hero__benefit">{t['hero.benefit']}</p>
    <p class="hero__urgency">{t['hero.urgency']}</p>
    <a
      href={waUrl}
      class="btn btn--whatsapp hero__cta"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t['hero.cta']} — WhatsApp`}
    >
      {t['hero.cta']}
    </a>
    <p class="hero__spoiler">{t['hero.spoiler']}</p>
  </div>
</section>

<script>
  const heroVideo = document.querySelector('.hero__video');
  const heroPoster = document.querySelector('.hero__poster');
  if (!(heroVideo instanceof HTMLVideoElement)) {
    // no-op
  } else {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 901px)').matches;
    const conn = /** @type {{ saveData?: boolean } | undefined} */ (navigator.connection);
    const saveData = Boolean(conn && conn.saveData);
    const src = heroVideo.dataset.src;

    const revealVideo = () => {
      heroVideo.classList.add('is-ready');
      heroPoster?.classList.add('is-hidden');
    };

    const loadAndPlay = () => {
      if (!src || heroVideo.getAttribute('src')) return;
      heroVideo.src = src;
      heroVideo.addEventListener('playing', revealVideo, { once: true });
      heroVideo.muted = true;
      const play = () => {
        heroVideo.play().catch(() => {});
      };
      heroVideo.addEventListener('canplay', play, { once: true });
      heroVideo.load();
    };

    // Mobile PSI / slow networks: keep static poster only
    if (!isDesktop || reducedMotion || saveData) {
      heroVideo.remove();
    } else {
      const start = () => loadAndPlay();
      const onInteract = () => {
        window.removeEventListener('pointerdown', onInteract);
        window.removeEventListener('scroll', onInteract);
        start();
      };
      window.addEventListener('pointerdown', onInteract, { once: true, passive: true });
      window.addEventListener('scroll', onInteract, { once: true, passive: true });
      setTimeout(start, 8000);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: var(--space-lg);
    padding: 5rem var(--container-padding) var(--space-xl);
    background: var(--color-bg);
  }
  .hero__media {
    position: relative;
    height: calc(100svh - 6.5rem);
    max-height: 820px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__poster,
  .hero__video {
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius);
  }
  .hero__poster {
    margin: 0;
    transition: opacity 0.35s ease;
  }
  .hero__poster img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius);
  }
  .hero__poster.is-hidden {
    opacity: 0;
    pointer-events: none;
    position: absolute;
    inset: 0;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    margin: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .hero__video.is-ready {
    opacity: 1;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    color: var(--color-text);
    max-width: 560px;
  }
  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .hero__benefit {
    font-size: var(--text-base);
    margin-top: var(--space-md);
  }
  .hero__urgency {
    font-weight: 600;
    color: var(--color-primary);
    margin-top: var(--space-sm);
  }
  .hero__cta {
    margin-top: var(--space-md);
    font-size: var(--text-base);
  }
  .hero__spoiler {
    margin-top: var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 5rem;
    }
    .hero__media {
      height: auto;
      max-height: none;
      aspect-ratio: 840 / 720;
    }
    .hero__poster,
    .hero__poster img,
    .hero__video {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .hero__content {
      max-width: none;
    }
  }
</style>
