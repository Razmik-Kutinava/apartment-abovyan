---
import type { Translations } from '../utils/i18n';
import { buildWhatsAppUrl } from '../utils/whatsapp';

interface Props { t: Translations; }
const { t } = Astro.props;
const waUrl = buildWhatsAppUrl(t['hero.cta_prefill']);
---

<section class="hero" aria-label="Hero">
  <div class="hero__media" role="img" aria-label={t['img.hero.alt']}>
    <video
      class="hero__video"
      src="/video/abovyan_garni.mp4"
      poster="/images/hero-atist-monument.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
  </div>
  <div class="container hero__content">
    <span class="badge">{t['hero.badge']}</span>
    <h1>{t['hero.title']}</h1>
    <p class="hero__subtitle">{t['hero.subtitle']}</p>
    <p class="hero__benefit">{t['hero.benefit']}</p>
    <p class="hero__urgency">{t['hero.urgency']}</p>
    <a href={waUrl} class="btn btn--whatsapp hero__cta" target="_blank" rel="noopener noreferrer">
      {t['hero.cta']}
    </a>
    <p class="hero__spoiler">{t['hero.spoiler']}</p>
  </div>
</section>

<script>
  const heroVideo = document.querySelector('.hero__video');
  if (heroVideo instanceof HTMLVideoElement) {
    heroVideo.muted = true;
    const playHeroVideo = () => {
      heroVideo.play().catch(() => {});
    };
    heroVideo.addEventListener('canplay', playHeroVideo, { once: true });
    playHeroVideo();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: var(--space-lg);
    padding: 5rem var(--container-padding) var(--space-xl);
    background: var(--color-bg);
  }
  .hero__media {
    height: calc(100svh - 6.5rem);
    max-height: 820px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__video {
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    pointer-events: none;
    border-radius: var(--radius);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    color: var(--color-text);
    max-width: 560px;
  }
  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .hero__benefit {
    font-size: var(--text-base);
    margin-top: var(--space-md);
  }
  .hero__urgency {
    font-weight: 600;
    color: var(--color-primary);
    margin-top: var(--space-sm);
  }
  .hero__cta {
    margin-top: var(--space-md);
    font-size: var(--text-base);
  }
  .hero__spoiler {
    margin-top: var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 5rem;
    }
    .hero__media {
      height: auto;
      max-height: none;
      aspect-ratio: 840 / 720;
    }
    .hero__video {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .hero__content {
      max-width: none;
    }
  }
</style>
